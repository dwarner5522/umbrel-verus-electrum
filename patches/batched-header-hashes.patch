+        # Verus headers are about 1.5 KB each and the header merkle cache asks
+        # for every header on the chain at once.  Read and hash them in
+        # batches so that takes megabytes of memory instead of gigabytes.
+        hashes = []
+        while count > 0:
+            batch = min(count, self.HEADER_HASH_BATCH)
+            headers_concat, headers_count = await self.read_headers(height, batch)
+            if headers_count != batch:
+                raise self.DBError('only got {:,d} headers starting at {:,d}, not '
+                                   '{:,d}'.format(headers_count, height, batch))
+            offset = 0
+            for n in range(batch):
+                hlen = self.header_len(height + n)
+                hashes.append(self.coin.header_hash(headers_concat[offset:offset + hlen]))
+                offset += hlen
+            height += batch
+            count -= batch
+
+        return hashes
 
